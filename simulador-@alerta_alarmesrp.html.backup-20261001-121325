<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0A0F1E"><meta name="robots" content="noindex,nofollow">
<title>Diagnóstico Gratuito | Sua empresa aqui</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#0A0F1E;--card:#131C33;--border:#253355;--blue:#2F6BFF;--light:#5B8CFF;--lime:#A4D233;--green:#25D366;--text:#E8ECF7;--muted:#93A0C2}*{box-sizing:border-box}body{margin:0;font-family:Poppins,Arial,sans-serif;color:var(--text);background:radial-gradient(ellipse at 50% 0,rgba(47,107,255,.19),transparent 60%),radial-gradient(circle,rgba(91,140,255,.12) 1px,transparent 1.5px) 0 0/26px 26px,var(--bg);min-height:100svh}button,input{font:inherit}button,a,input{-webkit-tap-highlight-color:transparent}button{cursor:pointer}button:focus-visible,a:focus-visible{outline:3px solid var(--lime);outline-offset:5px}[hidden]{display:none!important}.shell{max-width:1000px;margin:auto;padding:26px 32px;min-height:100svh;display:flex;flex-direction:column}.header{display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:12px;font-size:13px;font-weight:700}.brand img{width:52px;height:52px;object-fit:cover;border-radius:12px}.brand small{display:block;font-size:10px;color:var(--muted);font-weight:400;letter-spacing:1px}.label{font-size:10px;letter-spacing:1.3px;text-transform:uppercase;color:var(--muted)}.progress-area{margin-top:28px}.progress-meta{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-bottom:10px}.track{height:4px;background:var(--border);border-radius:10px;overflow:hidden}.fill{width:0;height:100%;background:linear-gradient(90deg,var(--blue),var(--lime));transition:width .35s}main{flex:1;display:flex;align-items:center;padding:48px 0}.screen{width:100%;max-width:650px;margin:auto;animation:enter .35s ease}.welcome,.thanks{text-align:center;max-width:690px}.eyebrow{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(164,210,51,.35);background:rgba(164,210,51,.1);color:var(--lime);border-radius:99px;padding:7px 13px;font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase}.eyebrow:before{content:'';width:6px;height:6px;background:var(--lime);border-radius:50%}h1,h2{color:#fff;letter-spacing:-1px;line-height:1.25;margin:20px 0 16px;font-size:clamp(25px,4vw,39px);font-weight:800}h1 span,.accent{color:var(--light)}.desc{font-size:14px;line-height:1.8;color:var(--muted);margin:0 0 28px}.welcome .desc,.thanks .desc{max-width:540px;margin:0 auto 28px}.step-label{color:var(--light);font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase}.step-label b{display:inline-flex;width:30px;height:30px;align-items:center;justify-content:center;border-radius:9px;background:rgba(47,107,255,.15);margin-right:9px}.primary{display:inline-flex;justify-content:center;align-items:center;gap:14px;border:0;background:var(--green);color:#072812;font-size:14px;font-weight:700;padding:17px 24px;border-radius:13px;box-shadow:0 10px 30px rgba(37,211,102,.18);text-decoration:none;transition:transform .2s,background .2s}.primary:hover{transform:translateY(-2px);background:#36e176}.primary .arrow{font-size:20px}.micro{font-size:11px;color:var(--muted);margin-top:15px;line-height:1.7}.pills{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:30px}.pill{background:var(--card);border:1px solid var(--border);border-radius:99px;padding:7px 11px;font-size:10px}.pill:before{content:'●';color:var(--lime);margin-right:6px}.field{width:100%;background:transparent;border:0;border-bottom:2px solid var(--border);border-radius:0;padding:14px 0;color:var(--text);font-size:clamp(20px,3vw,27px);outline:none;transition:border-color .2s}.field::placeholder{color:#657498}.field:focus{border-color:var(--light)}.field[aria-invalid=true]{border-color:#FF8A8A}.options{display:grid;gap:10px}.option{display:flex;align-items:center;gap:13px;text-align:left;width:100%;padding:16px;background:var(--card);border:1px solid var(--border);border-radius:14px;color:var(--text);font-size:13px;line-height:1.6;transition:background .2s,border-color .2s,transform .2s}.option:hover{border-color:var(--light);transform:translateX(3px)}.option[aria-checked=true]{border-color:var(--lime);background:rgba(164,210,51,.09);box-shadow:0 0 0 1px var(--lime)}.key{flex-shrink:0;border:1px solid #3c4b70;border-radius:6px;width:27px;height:27px;display:grid;place-items:center;color:var(--light);font-size:11px;font-weight:700}.option[aria-checked=true] .key{color:var(--bg);background:var(--lime);border-color:var(--lime)}.check{margin-left:auto;color:var(--lime);visibility:hidden}.option[aria-checked=true] .check{visibility:visible}.actions{display:flex;align-items:center;gap:18px;margin-top:26px}.hint{color:var(--muted);font-size:11px}.error{color:#FF8A8A;font-size:12px;min-height:19px;margin:12px 0 0}.bottom{display:flex;justify-content:space-between;align-items:center;gap:15px;border-top:1px solid rgba(37,51,85,.6);padding-top:20px;color:var(--muted);font-size:10px}.back,.restart{background:transparent;border:1px solid var(--border);color:var(--muted);border-radius:9px;padding:9px 13px;font-size:11px}.back:hover,.restart:hover{color:white;border-color:var(--light)}.success{width:68px;height:68px;margin:0 auto 22px;display:grid;place-items:center;border-radius:20px;background:rgba(164,210,51,.1);border:1px solid rgba(164,210,51,.4);font-size:30px;color:var(--lime)}.summary{text-align:left;background:var(--card);border:1px solid var(--border);border-radius:16px;padding:20px;margin:24px 0}.summary h3{font-size:12px;color:var(--light);margin:0 0 12px}.summary dl{margin:0}.summary .row{display:grid;grid-template-columns:115px 1fr;gap:12px;padding:9px 0;border-bottom:1px solid var(--border);font-size:11px;line-height:1.6}.summary .row:last-child{border:0}.summary dt{color:var(--muted)}.summary dd{margin:0;overflow-wrap:anywhere}.restart{margin-top:18px}h2:focus,h1:focus{outline:none}@keyframes enter{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}@media(max-width:560px){.shell{padding:20px}.header .label{display:none}main{padding:35px 0}.brand img{width:44px;height:44px}.progress-area{margin-top:22px}h1,h2{letter-spacing:-.6px}.primary{padding:16px 18px}.welcome .primary,.thanks .primary{width:100%}.hint{display:none}.option{padding:13px;font-size:12px}.bottom{font-size:9px}.summary .row{grid-template-columns:90px 1fr}.desc{font-size:13px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
.logo-placeholder{width:60px;height:52px;flex-shrink:0;display:flex;align-items:center;justify-content:center;text-align:center;border:1px dashed var(--light);border-radius:12px;background:rgba(47,107,255,.08);color:var(--light);font-size:10px;line-height:1.4;font-weight:600}</style>
</head>
<body>
<div class="shell">
<header class="header"><div class="brand"><div class="logo-placeholder" aria-label="Sua logo aqui">Sua logo<br>aqui</div><div>Sua empresa aqui<small>MONITORAMENTO 24h</small></div></div><span class="label">Diagnóstico gratuito</span></header>
<div class="progress-area" id="progressArea" hidden><div class="progress-meta"><span id="progressText"></span><span id="progressPercent"></span></div><div class="track" role="progressbar" aria-label="Progresso do diagnóstico" aria-valuemin="0" aria-valuemax="7" aria-valuenow="0"><div class="fill" id="fill"></div></div></div>
<main id="main"></main>
<footer class="bottom"><span>Sua empresa aqui · Segurança Eletrônica</span><button class="back" id="back" hidden type="button">← Voltar</button><span id="footerNote">Rápido. Simples. Sem compromisso.</span></footer>
</div>
<noscript>Ative o JavaScript do navegador para responder ao diagnóstico.</noscript>
<script>
'use strict';
// Modelo demonstrativo: informe o WhatsApp de destino (país + DDD + número).
const WHATSAPP_NUMERO=''; // Configure o WhatsApp da empresa antes de publicar.
const questions=[
 {id:'name',group:'Identificação e contato',title:'Como podemos chamar você?',desc:'',label:'Nome completo',placeholder:'Digite seu nome completo',autocomplete:'name'},
 {id:'phone',group:'Identificação e contato',title:'Qual é o seu WhatsApp?',desc:'Informe seu número com DDD para que nossa equipe possa conversar com você.',label:'WhatsApp com DDD',placeholder:'(51) 99999-9999',autocomplete:'tel-national',type:'tel'},
 {id:'location',group:'Identificação e contato',title:'Onde fica o imóvel?',desc:'Informe o bairro e a cidade do imóvel que você deseja proteger.',label:'Bairro e cidade do imóvel',placeholder:'Ex.: Centro, sua cidade',autocomplete:'off'},
 {id:'owner',group:'Identificação e contato',title:'Você é o proprietário ou tomador de decisão do imóvel?',options:['Sim','Não']},
 {id:'property',group:'Seu imóvel',title:'Qual tipo de imóvel você deseja proteger hoje?',options:['🏡 Casa ou Sobrado Residencial','🏢 Empresa, Comércio ou Galpão (CNPJ)','🏬 Condomínio Residencial ou Comercial (Síndico / Administradora)','🚜 Chácara, Sítio ou Área Rural']},
 {id:'situation',group:'Sua segurança hoje',title:'Você já possui algum sistema de segurança ou empresa no local?',options:['Não tenho nada instalado ainda.','Tenho equipamentos próprios, mas NÃO são monitorados 24h.','Já tenho empresa de monitoramento, mas estou insatisfeito com o serviço/preço.']},
 {id:'urgency',group:'Prazo do projeto',title:'Qual é o prazo em que você pretende implementar essa solução?',options:['Com urgência (mudei recentemente, estou em obra ou tive um incidente)','Nas próximas 2 a 3 semanas','Apenas pesquisando para um projeto futuro']}
];
const answers={};let step=-1;let autoAdvanceTimer=null;
const main=document.getElementById('main'),back=document.getElementById('back');
function esc(value){return String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function focusTitle(){main.querySelector('h1,h2')?.focus({preventScroll:true});window.scrollTo({top:0,behavior:'instant'});}
function render(){
 clearTimeout(autoAdvanceTimer);autoAdvanceTimer=null;
 const finished=step===questions.length,active=step>=0;
 document.getElementById('progressArea').hidden=!active;back.hidden=!active;document.getElementById('footerNote').hidden=active;
 const completed=Math.max(0,Math.min(step,questions.length));
 document.getElementById('progressText').textContent=finished?'Diagnóstico concluído':`Pergunta ${step+1} de ${questions.length}`;
 document.getElementById('progressPercent').textContent=Math.round(completed/questions.length*100)+'%';
 document.getElementById('fill').style.width=(completed/questions.length*100)+'%';
 document.querySelector('[role=progressbar]').setAttribute('aria-valuenow',completed);
 if(step===-1){main.innerHTML=`<section class="screen welcome"><div class="eyebrow">Sua segurança, é a nossa prioridade</div><h1 tabindex="-1">Faça sua cotação de<br><span>Segurança com a gente</span></h1><p class="desc">Responda poucas perguntas (em menos de 1 minuto) e solicite uma estimativa de projeto personalizado pro seu caso.</p><button class="primary" id="start" type="button">Iniciar Diagnóstico Gratuito <span class="arrow" aria-hidden="true">→</span></button><p class="micro">7 perguntas rápidas · Sem compromisso</p><div class="pills"><span class="pill">Sua cidade e região</span><span class="pill">Monitoramento 24h</span><span class="pill">Manutenção inclusa</span></div></section>`;document.getElementById('start').onclick=()=>{step=0;render();};}
 else if(finished){
 const rows=[['Nome','name'],['WhatsApp','phone'],['Localização','location'],['Decisor','owner'],['Imóvel','property'],['Situação atual','situation'],['Prazo','urgency']];
 const message='Olá! Concluí o Simulador de Segurança Inteligente e gostaria de receber uma estimativa de projeto.\n\n'+rows.map(([label,id])=>label+': '+answers[id]).join('\n');
 main.innerHTML=`<section class="screen thanks"><div class="success" aria-hidden="true">✓</div><div class="eyebrow">Tudo pronto para o próximo passo</div><h1 tabindex="-1">Diagnóstico Concluído com Sucesso, <span>${esc(answers.name.trim().split(/\s+/)[0])}!</span> 🎉</h1><p class="desc">Suas respostas estão prontas! Clique abaixo e envie a mensagem no WhatsApp para solicitar uma estimativa e receber as melhores opções para o seu imóvel com um dos nossos consultores técnicos.</p><a class="primary" id="whatsapp" href="${esc((WHATSAPP_NUMERO ? 'https://wa.me/'+WHATSAPP_NUMERO : 'https://wa.me/')+'?text='+encodeURIComponent(message))}" target="_blank" rel="noopener noreferrer">💬 Falar Agora com o Consultor no WhatsApp</a><p class="micro">O atendimento começa após você enviar a mensagem no WhatsApp.</p><div class="summary"><h3>CONFIRA SUAS RESPOSTAS</h3><dl>${rows.map(([label,id])=>`<div class="row"><dt>${label}</dt><dd>${esc(answers[id])}</dd></div>`).join('')}</dl></div><button class="restart" id="restart" type="button">Recomeçar diagnóstico</button></section>`;
 document.getElementById('restart').onclick=()=>{for(const key of Object.keys(answers))delete answers[key];step=-1;render();};
 }else{
 const q=questions[step];
 main.innerHTML=`<section class="screen"><div class="step-label"><b>${step+1}</b>${q.group}</div><h2 id="questionTitle" tabindex="-1">${q.title}</h2>${q.desc?`<p class="desc" id="description">${q.desc}</p>`:''}<form id="questionForm" novalidate>${q.options?`<div class="options" role="radiogroup" aria-labelledby="questionTitle">${q.options.map((option,i)=>`<button type="button" class="option" role="radio" aria-checked="${answers[q.id]===option}" data-index="${i}" tabindex="${answers[q.id]===option||(!answers[q.id]&&i===0)?0:-1}"><span class="key" aria-hidden="true">${String.fromCharCode(65+i)}</span><span>${option}</span><span class="check" aria-hidden="true">✓</span></button>`).join('')}</div>`:`<input class="field" id="answer" aria-label="${q.label}" aria-describedby="description error" type="${q.type||'text'}" ${q.type==='tel'?'inputmode="tel"':''} autocomplete="${q.autocomplete}" maxlength="${q.type==='tel'?20:140}" placeholder="${q.placeholder}" value="${esc(answers[q.id])}" required>`}<p class="error" id="error" role="alert"></p><div class="actions"><button class="primary" type="submit">${step===questions.length-1?'Concluir diagnóstico':'Continuar'} <span class="arrow" aria-hidden="true">→</span></button><span class="hint">pressione Enter ↵${q.options?' · ou escolha uma letra':''}</span></div>${step===0?'<p class="micro">Os dados ficam apenas nesta página durante o preenchimento. Ao final, você poderá enviá-los à empresa pelo WhatsApp para solicitar atendimento.</p>':''}</form></section>`;
 if(q.options){main.querySelectorAll('.option').forEach(button=>button.onclick=()=>selectOption(Number(button.dataset.index)));}
 else{const input=document.getElementById('answer');input.addEventListener('input',()=>{answers[q.id]=input.value;input.removeAttribute('aria-invalid');document.getElementById('error').textContent='';});if(q.type==='tel')input.addEventListener('input',()=>{let digits=input.value.replace(/\D/g,'');if(digits.startsWith('55')&&digits.length>11)digits=digits.slice(2);digits=digits.slice(0,11);input.value=digits.length>2?'('+digits.slice(0,2)+') '+digits.slice(2, digits.length>10?7:6)+(digits.length>6?'-'+digits.slice(digits.length>10?7:6):''):digits;answers[q.id]=input.value;});}
 document.getElementById('questionForm').onsubmit=event=>{event.preventDefault();advance();};
 }
 focusTitle();
}
function selectOption(index){const q=questions[step];if(!q?.options?.[index])return;answers[q.id]=q.options[index];main.querySelectorAll('.option').forEach((button,i)=>{button.setAttribute('aria-checked',i===index);button.tabIndex=i===index?0:-1;});document.getElementById('error').textContent='';clearTimeout(autoAdvanceTimer);const selectedStep=step;autoAdvanceTimer=setTimeout(()=>{autoAdvanceTimer=null;if(step===selectedStep)advance();},400);}
function advance(){const q=questions[step];let value=(answers[q.id]||'').trim(),error='';if(!value)error=q.options?'Selecione uma opção para continuar.':'Preencha este campo para continuar.';else if(q.id==='name'&&value.split(/\s+/).length<2)error='Informe seu nome completo, com nome e sobrenome.';else if(q.id==='phone'&&!/^[1-9]{2}\d{8,9}$/.test(value.replace(/\D/g,'')))error='Informe um número válido com DDD (10 ou 11 dígitos).';else if(q.id==='location'&&value.length<4)error='Informe o bairro e a cidade do imóvel.';if(error){document.getElementById('error').textContent=error;const input=document.getElementById('answer');if(input){input.setAttribute('aria-invalid','true');input.focus();}return;}answers[q.id]=value;step++;render();}
back.onclick=()=>{if(step>=0){step--;render();}};
document.addEventListener('keydown',event=>{if(event.ctrlKey||event.altKey||event.metaKey||event.target.matches('input,textarea'))return;const q=questions[step];if(q?.options){const key=event.key.toUpperCase();if(/^[A-D]$/.test(key)){const index=key.charCodeAt(0)-65;if(index<q.options.length){event.preventDefault();selectOption(index);main.querySelectorAll('.option')[index].focus();}}else if(['ArrowDown','ArrowRight','ArrowUp','ArrowLeft'].includes(event.key)){event.preventDefault();const current=q.options.indexOf(answers[q.id]);const index=(Math.max(current,0)+(['ArrowDown','ArrowRight'].includes(event.key)?1:-1)+q.options.length)%q.options.length;selectOption(index);main.querySelectorAll('.option')[index].focus();}else if(event.key==='Enter'&&!event.target.matches('.primary,.back')){event.preventDefault();advance();}}else if(event.key==='Enter'&&step===-1&&!event.target.matches('button')){event.preventDefault();step=0;render();}});
render();
</script>
</body>
</html>
